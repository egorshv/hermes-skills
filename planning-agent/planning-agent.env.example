PLANNER_HOME=$HOME/.local/share/planning-agent
PLANNER_DB=$HOME/.local/share/planning-agent/planner.db
PLANNER_POLICY=$HOME/.config/planning-agent/policy.yaml
GOOGLE_OAUTH_CLIENT=$HOME/.config/planning-agent/google_oauth_client.json
GOOGLE_TOKEN=$HOME/.config/planning-agent/google_token.json
PLANNING_CALENDAR_ID_FILE=$HOME/.config/planning-agent/planning_calendar_id
PLANNING_CALENDAR_NAME=Planning Agent
PLANNER_TIMEZONE=Europe/Moscow
# Only needed if schema.sql is not deployed next to planner_mcp/.
# PLANNER_SCHEMA=/opt/planning-agent/schema.sql
# Reads of user calendars belong to the google-workspace skill; see
# skills.config.planning.calendar_read_ids in the planning-agent skill.
